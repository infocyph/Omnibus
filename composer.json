{
    "name": "infocyph/omnibus",
    "description": "A unified, framework-agnostic event bus and reliable message queue for PHP.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "event-bus",
        "events",
        "message-bus",
        "queue",
        "worker"
    ],
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "infocyph/uid": "^5.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "infocyph/cachelayer": "^3.1",
        "infocyph/dblayer": "^4.0",
        "infocyph/phpforge": "dev-main@dev"
    },
    "suggest": {
        "ext-memcached": "Optional for Memcached-backed uniqueness and overlap leases.",
        "ext-msgpack": "One option for a CallbackEnvelopeSerializer binary codec.",
        "ext-redis": "Required by the native Redis/Valkey transport.",
        "aws/aws-sdk-php": "One option for implementing the native SQS backend boundary.",
        "infocyph/cachelayer": "Required for Omnibus CacheLayer coordination integrations; tested with CacheLayer 3.1.",
        "infocyph/dblayer": "Required for Omnibus database queue, workflow, failure-store and after-commit integrations; tested with DBLayer 4.x.",
        "php-amqplib/php-amqplib": "One option for implementing the native AMQP backend boundary."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\Omnibus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Omnibus\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.codex",
            "/.github",
            "/benchmarks",
            "/docs",
            "/examples",
            "/tests",
            "/vendor",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.readthedocs.yaml",
            "/captainhook.json",
            "/composer.lock",
            "/omnibus*.txt",
            "/pest.xml",
            "/phpbench.json",
            "/phpcs.xml.dist",
            "/phpstan.neon.dist",
            "/phpunit.xml",
            "/pint.json",
            "/plan*.md",
            "/psalm.xml",
            "/rector.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-drift": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "benchmark": "@php benchmarks/run.php",
        "benchmark:db-contention": "@php benchmarks/db-contention.php",
        "soak:consumer": "@php benchmarks/consumer-soak.php",
        "soak:durable": "@php benchmarks/durable-soak.php",
        "soak:workflow": "@php benchmarks/workflow-soak.php"
    }
}
