{
    "name": "infocyph/omnibus",
    "description": "A unified, framework-agnostic event bus and reliable message queue for PHP.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "event-bus",
        "events",
        "message-bus",
        "queue",
        "worker"
    ],
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "infocyph/uid": "^6.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "infocyph/cachelayer": "^4.0",
        "infocyph/dblayer": "^6.0",
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/runwire": "2.1.1"
    },
    "conflict": {
        "infocyph/cachelayer": "<4.0 || >=5.0",
        "infocyph/dblayer": "<6.0 || >=7.0",
        "infocyph/runwire": "<2.1.1 || >=3.0"
    },
    "suggest": {
        "ext-memcached": "Optional for Memcached-backed uniqueness and overlap leases.",
        "ext-msgpack": "One option for a CallbackEnvelopeSerializer binary codec.",
        "ext-pcntl": "Required for standalone native worker pools and explicit Worker signal handling.",
        "ext-posix": "Required for standalone process signaling and native/Runwire worker-pool supervision.",
        "ext-redis": "Required by the native Redis/Valkey transport.",
        "aws/aws-sdk-php": "One option for implementing the native SQS backend boundary.",
        "infocyph/cachelayer": "Enables Omnibus CacheLayer coordination integrations; supported with CacheLayer 4.x.",
        "infocyph/dblayer": "Enables DB queue, workflow, failure-store, and after-commit integrations; supported with DBLayer 6.x.",
        "infocyph/runwire": "Enables the optional standalone WorkerPool backend and host-context integration; supported with Runwire 2.x from 2.1.1.",
        "php-amqplib/php-amqplib": "One option for implementing the native AMQP backend boundary."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\Omnibus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Omnibus\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.codex",
            "/.github",
            "/benchmarks",
            "/docs",
            "/examples",
            "/graphify-out",
            "/tests",
            "/vendor",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.readthedocs.yaml",
            "/captainhook.json",
            "/composer.lock",
            "/omnibus*.txt",
            "/pest.xml",
            "/phpbench.json",
            "/phpcs.xml.dist",
            "/phpstan.neon.dist",
            "/phpunit.xml",
            "/pint.json",
            "/plan*.md",
            "/psalm.xml",
            "/rector.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-drift": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "benchmark": [
            "@php benchmarks/run.php",
            "@php benchmarks/worker-pool.php"
        ],
        "benchmark:db-contention": "@php benchmarks/db-contention.php",
        "benchmark:handler-middleware": "@php benchmarks/handler-middleware.php",
        "benchmark:release": "@php benchmarks/release.php build/benchmark-result.json",
        "benchmark:worker-pool": "@php benchmarks/worker-pool.php",
        "soak:consumer": "@php benchmarks/consumer-soak.php",
        "soak:durable": "@php benchmarks/durable-soak.php",
        "soak:worker-pool": "@php benchmarks/worker-pool.php 100 100",
        "soak:workflow": "@php benchmarks/workflow-soak.php"
    }
}
